{
  "name": "lexora-monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "Lexora - AI-powered legal document intelligence workspace monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --prefix apps/web run dev",
    "dev:web": "npm --prefix apps/web run dev",
    "dev:mobile": "npm --prefix apps/mobile start",
    "dev:api": "npm --prefix apps/api run dev",
    "build": "npm --prefix apps/web run build",
    "build:web": "npm --prefix apps/web run build",
    "build:api": "npm --prefix apps/api run build",
    "preview": "npm --prefix apps/web run preview",
    "mobile": "npm --prefix apps/mobile start"
  },
  "keywords": [
    "legaltech",
    "ai",
    "document-intelligence",
    "monorepo",
    "react",
    "react-native",
    "hono"
  ],
  "author": "Lexora Chambers",
  "license": "UNLICENSED"
}
